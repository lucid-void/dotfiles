# Tools referenced by scripts but not deployed as dotfiles
vscode/extensions.txt

# nvim plugin lockfile — each machine manages its own
.config/nvim/lazy-lock.json

# GUI terminal configs — desktop only
{{ if not .isDesktop }}
.config/alacritty
.config/ghostty
.local/share/applications
{{ end }}

# --- begin: hyprland UI layer (feat/hyprland-ui) ---
# Hyprland/quickshell desktop layer — meaningless on shell-only hosts (WSL, VMs, CI)
{{ if not .isDesktop }}
.config/hypr
.config/fish
.config/VSCodium
{{ end }}

# VSCodium runtime state — never manage. Only User/settings.json and
# User/keybindings.json are tracked; everything else here is machine-local
# (globalStorage 636K, workspaceStorage 744K, History 2.1M).
.config/VSCodium/User/globalStorage
.config/VSCodium/User/workspaceStorage
.config/VSCodium/User/History
.config/VSCodium/User/sync
.config/VSCodium/User/chatLanguageModels.json

# Generated at runtime — never manage these, they are derived state.
# matugen rewrites both on every wallpaper change (see ~/.config/matugen/config.toml).
.config/hypr/hyprland/colors.lua
.config/hypr/hyprlock/colors.conf
# --- end: hyprland UI layer ---
