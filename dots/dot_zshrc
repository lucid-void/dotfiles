# ── Environment ────────────────────────────────────────────────
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

export EDITOR="nvim"
export VISUAL="$EDITOR"

export BAT_THEME="Catppuccin Macchiato"

# Only export if the config actually exists — ripgrep ignores a missing file
# silently, which makes a dangling path easy to not notice.
[[ -f "$XDG_CONFIG_HOME/ripgrep/config" ]] \
  && export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"

# NOTE: TERM is deliberately *not* set here. The terminal emulator sets it
# correctly on its own (ghostty → xterm-ghostty, alacritty → alacritty,
# tmux → tmux-256color); overriding it costs truecolor and undercurl support.

# ── PATH ───────────────────────────────────────────────────────
# typeset -U keeps $path deduplicated when this file is re-sourced.
typeset -U path PATH

[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d "${KREW_ROOT:-$HOME/.krew}/bin" ]] && path=("${KREW_ROOT:-$HOME/.krew}/bin" $path)
# rustup's own installer (the non-Arch path) puts cargo/rustc here rather than
# in ~/.local/bin, and `cargo install` drops binaries here on every host. Arch's
# rustup package shims /usr/bin too, so this is additive, not a duplicate.
[[ -d "$HOME/.cargo/bin" ]] && path=("$HOME/.cargo/bin" $path)

export PATH

# Tools come from the packages/ lists (pacman/paru), so they are already on
# PATH — there is no version manager to activate here. The bat Catppuccin theme
# is fetched by run_once_install_bat_theme.sh rather than from this file.

# ── zinit ──────────────────────────────────────────────────────
ZINIT_HOME="${XDG_DATA_HOME}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#8087a2"  # overlay1

# Turbo-loaded (`wait`), so order and ices matter:
#   - atload'!_zsh_autosuggest_start' — without it autosuggestions registers its
#     precmd hook too late and silently misses the first prompt.
#   - fast-syntax-highlighting must be LAST: it wraps ZLE widgets, so anything
#     loaded after it goes unhighlighted.
#   - zicdreplay replays the compdefs queued during turbo load. This is the only
#     replay — there is deliberately no bare `zinit cdreplay` in the completion
#     section below, since running both would replay every compdef twice.
# zsh-users/zsh-completions is deliberately absent: carapace (below) covers the
# same ground and far more, so carrying both was duplicated startup work.
zinit wait lucid for \
  atload'!_zsh_autosuggest_start' zsh-users/zsh-autosuggestions \
                                  Aloxaf/fzf-tab \
                                  hlissner/zsh-autopair \
  atinit'zicdreplay'              zdharma-continuum/fast-syntax-highlighting

# OMZ sudo plugin: prefix the current line with sudo. Its default Esc-Esc binding
# collides with vi mode (Esc already leaves insert mode), so rebind to Alt-s and
# free Esc-Esc again.
_sudo_rebind() {
  bindkey -M viins '^[s' sudo-command-line
  bindkey -M vicmd '^[s' sudo-command-line
  bindkey -r -M vicmd '^[^['
}
zinit wait lucid atload'_sudo_rebind' for OMZP::sudo

# fzf-git: Ctrl-G Ctrl-{B,T,H,R,S} for branches, tags, hashes, remotes, stashes.
# Complements lazygit rather than overlapping it.
zinit wait lucid for junegunn/fzf-git.sh

# ── Prompt & tools ─────────────────────────────────────────────
# Guarded so a host that's missing one of these (partial/failed package
# install) degrades to a plain shell instead of erroring on every prompt.
# zoxide is deliberately NOT initialised here — see the end of this file.
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh)"

# thefuck spawns a Python interpreter at startup (~300ms), so it is loaded only
# when actually installed. It is unmaintained upstream — pay-respects is the
# maintained drop-in if this ever stops working.
if command -v thefuck >/dev/null 2>&1; then
  eval "$(thefuck --alias)"
fi

# kubectl's completion script is slow to generate, so cache it rather than
# regenerating on every shell. Delete the cache file after a kubectl upgrade.
if command -v kubectl >/dev/null 2>&1; then
  _kubectl_comp="${XDG_CACHE_HOME}/zsh/kubectl-completion.zsh"
  [[ -d "${_kubectl_comp:h}" ]] || mkdir -p "${_kubectl_comp:h}"
  [[ -s "$_kubectl_comp" ]] || kubectl completion zsh > "$_kubectl_comp"
  source "$_kubectl_comp"
  unset _kubectl_comp
fi

# ── Vi mode ────────────────────────────────────────────────────
bindkey -v
export KEYTIMEOUT=1

# ── Key bindings ───────────────────────────────────────────────
# `bindkey -v` above swaps zsh's emacs keymap out for the vi ones, and those
# bind the vi commands and almost nothing else — Home, End, Delete and the
# Ctrl/Alt-arrow variants all land on undefined-key, which is why they read as
# dead keys. Everything they used to do has to be re-bound here, in *both*
# keymaps, since a key that only works in insert mode is its own bug report.
#
# Terminals also disagree on what these keys emit. xterm-family terminals
# (ghostty, alacritty, foot, kitty) send ^[[H / ^[[F in normal cursor-key mode
# and ^[OH / ^[OF once something switches the terminal into application mode;
# tmux and the linux console send ^[[1~ / ^[[4~; rxvt sends ^[[7~ / ^[[8~. The
# alternative — forcing application mode with `echoti smkx` on every line — needs
# correct terminfo on every host and leaks the mode into anything that doesn't
# reset it, so bind every variant instead. Unused bindings cost nothing.
_bindkey_both() {
  local widget=$1 seq
  for seq in "${@:2}"; do
    bindkey -M viins "$seq" "$widget"
    bindkey -M vicmd "$seq" "$widget"
  done
}

_bindkey_both beginning-of-line '^[[H'    '^[OH'    '^[[1~' '^[[7~'
_bindkey_both end-of-line       '^[[F'    '^[OF'    '^[[4~' '^[[8~'
_bindkey_both delete-char       '^[[3~'
_bindkey_both forward-word      '^[[1;5C' '^[[1;3C' '^[[5C' '^[Oc' '^[f'  # Ctrl/Alt-Right
_bindkey_both backward-word     '^[[1;5D' '^[[1;3D' '^[[5D' '^[Od' '^[b'  # Ctrl/Alt-Left
_bindkey_both kill-word         '^[[3;5~'                                 # Ctrl-Delete

# Backstop for anything the literal list missed — the linux console, or an
# unusual TERM. Silently skipped when the capability isn't in the terminfo db.
zmodload -i zsh/terminfo
[[ -n "${terminfo[khome]}" ]] && _bindkey_both beginning-of-line "${terminfo[khome]}"
[[ -n "${terminfo[kend]}"  ]] && _bindkey_both end-of-line       "${terminfo[kend]}"
[[ -n "${terminfo[kdch1]}" ]] && _bindkey_both delete-char       "${terminfo[kdch1]}"

unfunction _bindkey_both

# vi mode binds Backspace to vi-backward-delete-char, which refuses to delete
# past the column where insert mode began — it reads as the key having died
# mid-line. backward-delete-char has no such limit. ^? is Backspace; ^H is what
# xterm-family terminals send for Ctrl-Backspace.
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-kill-word

# Emacs-style editing inside insert mode: muscle memory that predates vi mode
# and that nothing else claims. ^R / ^T / Alt-C are fzf's and ^G is fzf-git's,
# so they are deliberately absent. ^A only lands outside tmux — inside a session
# tmux takes it as the prefix.
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^Y' yank

# History search on arrow keys, in both insert and normal mode. ^[OA / ^[OB are
# the application-cursor-mode forms of the same two keys.
bindkey -M viins '^[[A' history-search-backward
bindkey -M viins '^[[B' history-search-forward
bindkey -M viins '^[OA' history-search-backward
bindkey -M viins '^[OB' history-search-forward
bindkey -M vicmd '^[[A' history-search-backward
bindkey -M vicmd '^[[B' history-search-forward
bindkey -M vicmd '^[OA' history-search-backward
bindkey -M vicmd '^[OB' history-search-forward
bindkey -M vicmd 'k'    history-search-backward
bindkey -M vicmd 'j'    history-search-forward

# Cursor shape follows the keymap: beam in insert, block in normal. These are
# DECSCUSR escapes (CSI Ps SP q), understood by alacritty, kitty, foot, wezterm
# and VTE-based terminals. Terminals that don't know the sequence ignore it, so
# there is nothing to guard against.
_cursor_beam()  { print -n '\e[5 q' }  # 5 = blinking bar
_cursor_block() { print -n '\e[2 q' }  # 2 = steady block

# Fires on every keymap change, including the Esc that leaves insert mode.
zle-keymap-select() {
  case "$KEYMAP" in
    vicmd|visual|viopp) _cursor_block ;;
    *)                  _cursor_beam  ;;
  esac
}
# Each new prompt starts in insert mode, so start from the beam. `zle -K viins`
# is belt-and-braces: without it a line abandoned in normal mode (Ctrl-C) can
# leave the next prompt in vicmd with a beam cursor.
zle-line-init() { zle -K viins; _cursor_beam }
zle -N zle-keymap-select
zle -N zle-line-init

# Hand the cursor back before running a command — otherwise a block cursor
# leaks into whatever is launched (pagers, TUIs that don't set their own).
autoload -Uz add-zsh-hook
add-zsh-hook preexec _cursor_beam

# ── History ────────────────────────────────────────────────────
HISTFILE="${XDG_STATE_HOME}/zsh/history"
HISTSIZE=1000000
SAVEHIST=$HISTSIZE
[[ ! -d "$(dirname "$HISTFILE")" ]] && mkdir -p "$(dirname "$HISTFILE")"
setopt APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_VERIFY

# ── Shell options ──────────────────────────────────────────────
setopt AUTO_CD
setopt COMPLETE_IN_WORD
setopt NO_BEEP
setopt NO_BG_NICE   # don't deprioritise background jobs

# ── Completion ─────────────────────────────────────────────────
autoload -Uz compinit _zinit
[[ ! -d "${XDG_CACHE_HOME}/zsh" ]] && mkdir -p "${XDG_CACHE_HOME}/zsh"
_zcompdump="${XDG_CACHE_HOME}/zsh/zcompdump-${ZSH_VERSION}"
if [[ -n ${_zcompdump}(#qN.mh+24) ]]; then
  compinit -d "$_zcompdump"
else
  compinit -C -d "$_zcompdump"
fi
unset _zcompdump
# NOTE: no `zinit cdreplay -q` here — the replay is done once via
# atinit'zicdreplay' on fast-syntax-highlighting in the zinit block above.
(( ${+_comps} )) && _comps[zinit]=_zinit

# `menu no` is required by fzf-tab — with `menu select` zsh draws its own
# selection menu and fzf-tab never takes over.
zstyle ':completion:*' menu no
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' list-separator '─'
# group-name '' splits results by tag (e.g. "external command" vs "alias")
# instead of one flat list, so fzf-tab renders one colored header per group.
zstyle ':completion:*' group-name ''
# Catppuccin Macchiato lavender, bold — the `:*' format (not `:descriptions')
# is what fzf-tab reads for its group headers; `:descriptions' below is the
# separate style compsys itself uses for plain-menu message lines.
zstyle ':completion:*' format $'\e[1;38;2;183;189;248m── %d ──\e[0m'
zstyle ':completion:*:descriptions' format $'\e[1;38;2;183;189;248m%d\e[0m'

# fzf-tab previews
zstyle ':fzf-tab:complete:cd:*'          fzf-preview 'eza --tree --icons --color=always $realpath 2>/dev/null | head -50'
zstyle ':fzf-tab:complete:__zoxide_z:*'  fzf-preview 'eza --tree --icons --color=always $realpath 2>/dev/null | head -50'
zstyle ':fzf-tab:complete:*'             fzf-preview 'bat --color=always $realpath 2>/dev/null | head -50'
zstyle ':fzf-tab:*'              switch-group ',' '.'
# Press '/' inside a path completion to drill into the selected directory
# without leaving the fzf-tab popup, instead of accept-then-retab.
zstyle ':fzf-tab:*' continuous-trigger '/'

# ── Shell integrations (must come after compinit) ──────────────
# carapace: completion engine covering ~1000 CLIs (gh, docker, kubectl). This
# replaces zsh-users/zsh-completions entirely — broader coverage, stays current,
# and one less turbo-loaded plugin. The zsh bridge still picks up any native
# compsys completions on fpath (kubectl's cached script, distro-shipped ones),
# so dropping the plugin loses nothing.
if command -v carapace >/dev/null 2>&1; then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  source <(carapace _carapace)
fi

# ── fzf ────────────────────────────────────────────────────────
# .git/ exclusion comes from dot_config/fd/ignore now, not a per-command flag.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --inline-info'
FZF_DEFAULT_OPTS+=' --color=bg+:#363a4f,bg:#24273a,spinner:#f4dbd6,hl:#ed8796'
FZF_DEFAULT_OPTS+=' --color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6'
FZF_DEFAULT_OPTS+=' --color=marker:#b7bdf8,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796'
FZF_DEFAULT_OPTS+=' --color=selected-bg:#494d64'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always {} 2>/dev/null | head -50'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow'
export FZF_ALT_C_OPTS="--preview 'eza --tree --icons --color=always {} 2>/dev/null | head -50'"

# ── Aliases — navigation ───────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'

# ── Aliases — tools ────────────────────────────────────────────
# --icons=auto so icons are dropped when piped or on a font-less console.
alias ls='eza --icons=auto'
alias lss='eza'
alias ll='eza -lah --icons=auto --git'
alias lt='eza --tree --icons=auto'
alias cat='bat --paging=never'
alias grep='rg --color=auto'
alias find='fd'
alias vim='nvim'
alias vi='nvim'
alias lg='lazygit'
alias c='clear'
alias python='python3'
# codium is a desktop-only package (.chezmoiignore drops its config on headless),
# so on a VM this aliased `code` to a command that does not exist — which is
# worse than no alias, because it also masks any real `code` on PATH.
command -v codium >/dev/null 2>&1 && alias code='codium'

# ── Functions ──────────────────────────────────────────────────
# Refresh font cache (fonts live under ~/.local/share/fonts — no sudo needed)
update_fonts() {
  fc-cache -fv
}

# Rebuild quickshell against the Qt it will actually run under. quickshell links
# Qt's *private* API, which carries no ABI guarantee even between patch releases,
# so a qt6-base bump leaves the installed binary aborting on an undefined symbol
# and Hyprland comes up bare — cursor on a blank colour, no bar, no wallpaper, no
# themed launcher. pacman's quickshell-check.hook reports it at upgrade time, but
# it scrolls past in the transaction output. The PKGBUILD pins its commit, so this
# recompiles the quickshell you already had rather than pulling a newer one.
# Flags: -s reinstalls the makedeps (cli11 and vulkan-headers get reaped as
# orphans between rebuilds), -i installs the result, -f overwrites the stale
# package file. Restart the shell afterwards with Ctrl+Super+R.
rebuild-qt() {
  local builddir=~/.cache/dots-hyprland/sdata/dist-arch/illogical-impulse-quickshell-git
  if [[ ! -f $builddir/PKGBUILD ]]; then
    print -u2 "rebuild-qt: no PKGBUILD under $builddir"
    print -u2 "rebuild-qt: re-run the dots-hyprland installer to restore the build tree"
    return 1
  fi
  # Subshell so a failed build does not strand the caller in the build directory.
  ( cd $builddir && makepkg -sif "$@" )
}

# Print the byte sequence a key actually sends, in bindkey's own notation — the
# only reliable way to fix a "this key does nothing" report, since the answer
# depends on the terminal, on tmux, and on whether the terminal is in
# application cursor mode. Paste the output straight into a bindkey line.
keyseq() {
  local k seq
  print -n "Press one key: "
  read -rsk 1 k || return
  seq=$k
  # The rest of an escape sequence arrives in the same burst; 50ms is long
  # enough to catch it and short enough not to wait on a lone Esc.
  while read -rsk 1 -t 0.05 k; do seq+=$k; done
  print -r -- "${(V)seq}"
}

# ── zoxide ─────────────────────────────────────────────────────
# Initialised last, on zoxide's own instructions: it wraps `cd` and installs a
# chpwd hook, and anything that touches either afterwards trips its startup
# self-check, which then prints a four-line "possible configuration issue"
# warning on *every* new shell. Loading it up with starship/fzf did exactly
# that — compinit, carapace and the turbo-loaded plugins all land after that
# point. Directory tracking worked either way; the warning was the problem.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"

# ── Agent shells (Claude Code) ─────────────────────────────────
# Claude Code runs one interactive zsh per session, snapshots the aliases,
# functions and exported environment that shell ends up with, and replays the
# snapshot in front of every command it runs. So every trade above of exactness
# for ergonomics also lands on the agent's commands — where there is no human to
# appreciate it, and no TTY for the tools to degrade gracefully against.
#
# CLAUDECODE=1 comes from the claude process itself, so it is already set in the
# shell that gets snapshotted. Undone here, at the end, rather than guarded at
# each definition above: the interactive path stays one straight read, and this
# stays one block to delete. Everything worth inheriting — PATH, EDITOR, XDG_*,
# the zoxide database itself — is deliberately left alone.
if [[ -n "$CLAUDECODE" ]]; then
  # Every rg invocation reads this file, including the ripgrep inside the claude
  # binary that backs the agent's own search tool. `--max-columns=200` there is
  # actively harmful rather than merely noisy: a match on a longer line is still
  # reported as a hit, but printed with the matched text cut off and replaced by
  # `[... omitted end of long line]`. `--smart-case` and `--hidden` quietly
  # change what a given search even means. Interactive rg keeps all of it.
  unset RIPGREP_CONFIG_PATH

  # Not about color — bat and eza both detect the missing TTY and plain
  # themselves out already. It is about these being *different programs*: eza
  # rejects ls flags it doesn't implement and renders its own column layout,
  # bat has its own flag set, and rg's CLI is not grep's. `grep` and `find` are
  # listed because Claude Code installs its own shims over them; dropping the
  # aliases here just means the fallback is real grep/find rather than a
  # near-miss. vim/vi/lg/python/.. are unambiguous and stay.
  unalias ls lss ll lt cat grep find 2>/dev/null

  # zoxide's self-check fires on the snapshot: the replay restores zoxide's
  # functions but not the chpwd_functions array, and a missing __zoxide_hook is
  # exactly the "something clobbered cd after I loaded" case the doctor looks
  # for. Four lines of warning on stderr in front of every command. This is not
  # the "initialise zoxide last" problem it reports — that is already true above
  # — so it is suppressed here only, and interactive shells keep the check.
  export _ZO_DOCTOR=0
fi

# ── Greeting ───────────────────────────────────────────────────
# Skipped inside tmux so every new pane doesn't redraw the whole fetch, and
# under Claude Code, whose snapshot shell would render one nobody ever sees.
if [[ -z "$TMUX" && -z "$CLAUDECODE" ]] && command -v fastfetch >/dev/null 2>&1; then
  fastfetch
fi

# ── Local overrides ────────────────────────────────────────────
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
