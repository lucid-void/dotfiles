#!/usr/bin/env bash
# Takes netbird@main.service out of the boot-critical path.
#
# Why this exists: netbird@.service is `WantedBy=multi-user.target`, so it is
# part of the same startup transaction as multi-user.target (and
# graphical.target after it) — and its own `After=network-online.target`
# (`Wants=network-online.target`) makes that transaction wait for
# NetworkManager-wait-online.service to decide every interface is online.
# Measured on this machine: NetworkManager-wait-online.service alone took
# 5.49s, the single biggest chunk of the ~10s userspace portion of boot
# (`systemd-analyze critical-chain` showed the exact chain: graphical.target
# -> multi-user.target -> netbird@main.service -> network-online.target ->
# NetworkManager-wait-online.service).
#
# A drop-in resetting netbird@.service's own After=/Wants= was tried first and
# does not work: `systemctl show -p After` keeps reporting network-online.target
# even with an isolated `After=` reset and nothing else in the override —
# verified on this system on two unrelated units, not just netbird, so it is
# not worth fighting further. The reliable fix is to stop entailing netbird in
# the boot transaction at all: disable its instance-specific enablement
# (`/etc/systemd/system/multi-user.target.wants/netbird@main.service`, which
# is what actually pulls it in — the vendor unit's own [Install] WantedBy is
# untouched) and start it instead from a `.timer` a few seconds after boot.
# A timer unit's own job (arming the timer) finishes immediately regardless of
# when it is set to fire, so nothing downstream waits on it — this is the
# standard way to defer a unit out of the boot-blocking graph without masking
# anything network-wide (NetworkManager-wait-online.service itself is left
# alone; other boot-order issues are tracked separately).
#
# netbird does not need the network to be fully "online" before it starts —
# it is a long-running daemon with its own reconnect loop, the same way it
# already copes with the network dropping after boot.
{{ includeTemplate "sh-preamble" (dict
     "prefix" "netbird-boot"
     "what"   "a faster boot without netbird blocking it"
     "why"    "no netbird service to speed up"
     "ctx"    .) }}
SERVICE=/etc/systemd/system/netbird-deferred-start.service
TIMER=/etc/systemd/system/netbird-deferred-start.timer
ENABLEMENT=/etc/systemd/system/multi-user.target.wants/netbird@main.service

if ! systemctl list-unit-files 'netbird@.service' >/dev/null 2>&1; then
  warn "netbird@.service not installed — nothing to defer, skipping"
  exit 0
fi

staged_service="$(mktemp)" || { warn "could not create a temp file — skipping"; exit 0; }
trap 'rm -f "$staged_service" "$staged_timer"' EXIT
staged_timer="$(mktemp)" || { warn "could not create a temp file — skipping"; exit 0; }

cat >"$staged_service" <<'EOF'
[Unit]
Description=Start netbird@main.service a few seconds after boot
After=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start netbird@main.service
EOF

cat >"$staged_timer" <<'EOF'
[Unit]
Description=Delay netbird@main.service out of the boot-critical path

[Timer]
OnBootSec=15s
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF

# The common case on every apply after the first: already correct, netbird's
# own boot-time enablement already gone.
if cmp -s "$staged_service" "$SERVICE" 2>/dev/null \
  && cmp -s "$staged_timer" "$TIMER" 2>/dev/null \
  && [[ ! -e "$ENABLEMENT" ]]; then
  exit 0
fi

if ! sudo -n true 2>/dev/null && [[ ! -t 0 ]]; then
  warn "need root to defer netbird@main.service and sudo would prompt with no terminal attached"
  warn "re-run \`chezmoi apply\` from an interactive shell to finish this step"
  exit 0
fi

if ! install_err="$(sudo install -m 644 -o root -g root "$staged_service" "$SERVICE" 2>&1)"; then
  warn "could not write $SERVICE: ${install_err:-no output}"
  exit 0
fi

if ! install_err="$(sudo install -m 644 -o root -g root "$staged_timer" "$TIMER" 2>&1)"; then
  warn "could not write $TIMER: ${install_err:-no output}"
  exit 0
fi

if ! reload_err="$(sudo systemctl daemon-reload 2>&1)"; then
  warn "wrote the deferred-start units but \`systemctl daemon-reload\` failed: ${reload_err:-no output}"
  exit 0
fi

if ! enable_err="$(sudo systemctl enable --now netbird-deferred-start.timer 2>&1)"; then
  warn "could not enable netbird-deferred-start.timer: ${enable_err:-no output}"
  exit 0
fi

# This is what actually removes netbird from the boot transaction. Left for
# last: everything above is harmless on its own, this is the one step that
# changes what boot waits for, and it should only happen once the timer that
# replaces it is confirmed working.
if [[ -e "$ENABLEMENT" ]]; then
  if ! disable_err="$(sudo systemctl disable netbird@main.service 2>&1)"; then
    warn "could not disable netbird@main.service's boot-time enablement: ${disable_err:-no output}"
    warn "the deferred timer is active, but netbird@main.service may still start twice at boot"
  fi
fi

printf 'netbird-boot: netbird@main.service no longer blocks boot, starts ~15s after instead\n'

exit 0
