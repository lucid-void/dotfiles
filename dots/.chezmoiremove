# Target paths chezmoi deletes from $HOME on every apply.
#
# chezmoi does not remove a file from the target just because it disappeared
# from the source, so anything retired has to be listed here explicitly.

# Retired: the Brave launcher for the flatpak build. Both browsers are native
# AUR packages now, replaced by brave-origin.desktop and chromium.desktop.
.local/share/applications/com.brave.Browser.desktop

# Retired: the pre-XDG tmux config — and not merely stale. tmux 3.1+ loads
# *every* file in its config list, so ~/.tmux.conf is still sourced first and
# ~/.config/tmux/tmux.conf then overrides it line by line. Anything the managed
# config stops setting would silently come back from here.
.tmux.conf

# Retired: the pre-XDG completion dump. .zshrc writes
# $XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION now.
.zcompdump
