# GUI-only configs — desktop machines only.
# VSCodium is here because remote-ssh and Codespaces don't read
# ~/.config/VSCodium on the remote end; they use ~/.vscode-server/ instead.
{{ if not .isDesktop }}
.config/alacritty
.config/ghostty
.config/kitty
.config/VSCodium
.local/share/applications

# Hyprland and its quickshell bar are a Wayland desktop shell, so nothing on a
# headless box can start them. quickshell is also the single biggest thing this
# repo deploys — ~17 MB, and .config/quickshell/end4-pC is a git submodule, so
# the cost is a submodule checkout too. Ignoring is not removing: .chezmoiremove
# clears these from hosts provisioned before this entry landed.
.config/hypr
.config/quickshell

# MangoHud draws an FPS/thermals overlay onto Vulkan and OpenGL swapchains.
# There is no GPU, no compositor and nothing rendering a frame on a headless
# box, so the config is inert there.
.config/MangoHud

# The aria2 daemon exists solely to catch downloads handed off by a browser
# extension, so it follows the browser. run_setup_aria2.sh guards itself on
# .isDesktop the same way run_install_adnauseam.sh does, and no-ops here.
.config/aria2
.config/systemd/user/aria2.service

# Nerd Fonts are pointless where nothing renders a glyph — headless nodes, VMs
# and Codespaces all draw in the *local* terminal. Skipping the download saves
# ~50 MB and the fontconfig dependency.
#
# Scripts are matched here by their target name, which is the source filename
# with the `run_once_` prefix stripped — NOT `run_once_install_fonts.sh`.
# Verify any change with `chezmoi managed | grep install_`.
install_fonts.sh

# VSCodium itself is ignored above on headless, so its extensions have
# nothing to install into either.
install_vscodium_extensions.sh
{{ end }}
