#!/usr/bin/env bash
# Installs the chromium-web-store extension (NeverDecaf) as an unpacked
# extension into ~/.local/share/chromium-web-store.
#
# ungoogled-chromium ships with Chrome Web Store integration stripped, so the
# store's install/update buttons don't do anything by default. This extension
# patches them back to working. Upstream's documented install method is
# interactive (flip chrome://flags/#extension-mime-request-handling, then
# drag the .crx onto the browser); loading it unpacked via --load-extension
# instead needs no interactive step, mirroring how AdNauseam is installed
# below.
#
# Both browser desktop entries pass the resulting directory via
# --load-extension in the shared dots/.chezmoitemplates/browser-extension-flags
# template, so the directory has to exist and stay put — Chromium reads it on
# every launch, it is not copied into the browser profile.
{{ if not .isDesktop }}
# Headless machine: no browser to load the extension into.
exit 0
{{ end }}
# Deliberately not `set -e`. A chezmoi run_once_ script that exits non-zero
# aborts the whole `chezmoi apply`, and a browser extension is not worth failing
# a dotfiles install over. Every failure path below warns and exits 0; Chromium
# ignores a missing --load-extension directory, so skipping degrades quietly.
set -uo pipefail

DEST="$HOME/.local/share/chromium-web-store"
URL="https://github.com/NeverDecaf/chromium-web-store/releases/latest/download/Chromium.Web.Store.crx"

warn() { printf 'chromium-web-store: %s\n' "$*" >&2; }

for cmd in curl unzip; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    warn "$cmd not found — skipping install (Chromium tolerates the missing dir)"
    exit 0
  fi
done

tmp="$(mktemp -d)" || { warn "could not create temp dir — skipping"; exit 0; }
trap 'rm -rf "$tmp"' EXIT

# `latest/download/Chromium.Web.Store.crx` is an unversioned alias the project
# publishes alongside its versioned assets, so this always tracks the newest
# release without having to parse the GitHub API.
if ! curl -fsSL --retry 3 --connect-timeout 20 -o "$tmp/cws.crx" "$URL"; then
  warn "download failed — skipping"
  exit 0
fi

# A .crx is a small binary header (magic + version + protobuf) glued in front
# of an ordinary zip archive, with manifest.json at its root. unzip locates the
# zip's central directory by scanning backward from EOF, so it extracts fine —
# it just warns about the leading header bytes and exits 1 even on success.
# Check for manifest.json instead of the exit code.
unzip -q -o "$tmp/cws.crx" -d "$tmp/extracted" 2>/dev/null
if [[ ! -f "$tmp/extracted/manifest.json" ]]; then
  warn "no manifest.json found after extraction — skipping"
  exit 0
fi

# Stage the new copy beside the destination, then swap, so an interrupted run
# never leaves a half-extracted extension where the browsers expect a working one.
mkdir -p "$(dirname "$DEST")"
rm -rf "$DEST.new"
mv "$tmp/extracted" "$DEST.new"
rm -rf "$DEST"
mv "$DEST.new" "$DEST"

version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DEST/manifest.json" | head -1)"
printf 'chromium-web-store: installed %s to %s\n' "${version:-unknown version}" "$DEST"
printf 'chromium-web-store: restart Brave / Chromium to load it\n'
