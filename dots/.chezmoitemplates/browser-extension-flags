{{/*
  Chromium-family flags shared by every browser desktop entry in this repo, so
  Brave and ungoogled-chromium can never drift apart on which extensions they load.

  Consumed as:  {{ includeTemplate "browser-extension-flags" . | trim }}
  The `trim` is required — without it the trailing newline breaks the Exec= line.

  To add another unpacked extension, append to --load-extension as a
  comma-separated list of directories:
      --load-extension=/path/one,/path/two

  Only flags both browsers understand belong here. Anything ungoogled-chromium
  adds by patch (--extension-mime-request-handling, for one) goes straight into
  chromium.desktop.tmpl instead.

  --disable-features=ExtensionManifestV2Unsupported keeps MV2 extensions
  (AdNauseam is MV2) loadable on Chromium builds that have started phasing MV2 out.
*/ -}}
--load-extension={{ .chezmoi.homeDir }}/.local/share/adnauseam,{{ .chezmoi.homeDir }}/.local/share/chromium-web-store --disable-features=ExtensionManifestV2Unsupported
