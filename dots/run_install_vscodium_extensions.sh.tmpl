#!/usr/bin/env bash
# Installs/updates the VSCodium extensions listed in
#   packages/vscodium-extensions.txt          (codium's configured gallery)
#   packages/vscodium-extensions-openvsx.txt  (VSIX fetched from Open VSX)
# including the ones dot_config/VSCodium/User/settings.json depends on. Runs on
# every `chezmoi apply` (plain `run_` prefix, not `run_once_`) so extensions get
# pulled to their latest version each time, not just installed once and left to
# drift.
#
# Deliberately not `set -e`. This script sorts second-to-last in chezmoi's
# target-name ordering, immediately before setup_aria2.sh — so an Open VSX
# outage or a single extension that has gone missing from the gallery used to
# take the aria2 daemon setup down with it. Every failure path warns and the
# rest of the list still gets installed.
set -uo pipefail

warn() { printf 'vscodium: %s\n' "$*" >&2; }

# Both lists live outside the chezmoi source directory, so they are embedded
# here at apply time rather than read at run time — the same arrangement as
# run_install_browser_extensions.sh.tmpl. `.chezmoiroot` pins the source
# directory to <repo>/dots, which makes ../packages deterministic. Embedding is
# also what lets chezmoi notice a list edit at all: the rendered script changes
# whenever a list does, so `chezmoi apply` re-runs it.
{{- $extList := joinPath .chezmoi.sourceDir ".." "packages" "vscodium-extensions.txt" }}
{{- $vsxList := joinPath .chezmoi.sourceDir ".." "packages" "vscodium-extensions-openvsx.txt" }}
{{- if not (stat $extList) }}
# Missing at render time. Say so explicitly: an empty list is indistinguishable
# from an absent file once the heredoc is written, and "nothing to install"
# reads as "your list is empty" rather than "the file chezmoi expected is gone".
warn "packages/vscodium-extensions.txt not found — skipping the gallery list"
warn "  expected at {{ $extList }}"
{{- end }}
{{- if not (stat $vsxList) }}
warn "packages/vscodium-extensions-openvsx.txt not found — skipping the Open VSX list"
warn "  expected at {{ $vsxList }}"
{{- end }}
EXT_LIST_RAW="$(cat <<'DOTFILES_EXTENSION_LIST'
{{ if stat $extList }}{{ include $extList }}{{ end }}
DOTFILES_EXTENSION_LIST
)"

OPENVSX_LIST_RAW="$(cat <<'DOTFILES_OPENVSX_LIST'
{{ if stat $vsxList }}{{ include $vsxList }}{{ end }}
DOTFILES_OPENVSX_LIST
)"

# Strip comments, keep only well-formed <publisher>.<name> IDs so a typo yields
# one skipped extension rather than handing codium a garbage argument.
# NB: strip spaces/tabs/CR but NOT newlines — `tr -d '[:space:]'` would fold the
# whole list onto one line and match nothing.
parse_list() {
  printf '%s\n' "$1" | sed 's/#.*//' | tr -d ' \t\r' \
    | grep -E '^[A-Za-z0-9_-]+\.[A-Za-z0-9._-]+$' || true
}

mapfile -t EXTENSIONS < <(parse_list "$EXT_LIST_RAW")
mapfile -t OPENVSX_EXTENSIONS < <(parse_list "$OPENVSX_LIST_RAW")

if [[ ${#EXTENSIONS[@]} -eq 0 && ${#OPENVSX_EXTENSIONS[@]} -eq 0 ]]; then
  warn "no valid extension IDs in either list — nothing to do"
  exit 0
fi

if ! command -v codium >/dev/null 2>&1; then
  echo "codium not on PATH — skipping extension install."
  exit 0
fi

failed=0

for ext in ${EXTENSIONS[@]+"${EXTENSIONS[@]}"}; do
  echo "Installing $ext..."
  # NODE_NO_WARNINGS silences codium's own DEP0169 url.parse() deprecation
  # noise (upstream cliProcessMain.js, not ours to fix) on every extension.
  NODE_NO_WARNINGS=1 codium --install-extension "$ext" --force \
    || { warn "$ext failed to install"; failed=$((failed + 1)); }
done

if [[ ${#OPENVSX_EXTENSIONS[@]} -gt 0 ]]; then
  # jq parses the Open VSX API reply. It is in packages/headless.txt, but a
  # bare `chezmoi apply` on a machine that never ran install.sh won't have it —
  # guard rather than dying on `jq: command not found`.
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq not installed — skipping the Open VSX extensions: ${OPENVSX_EXTENSIONS[*]}"
  elif ! command -v curl >/dev/null 2>&1; then
    warn "curl not installed — skipping the Open VSX extensions: ${OPENVSX_EXTENSIONS[*]}"
  else
    vsixdir="$(mktemp -d)" || { warn "could not create temp dir — skipping Open VSX"; exit 0; }
    trap 'rm -rf "$vsixdir"' EXIT

    for ext in "${OPENVSX_EXTENSIONS[@]}"; do
      echo "Installing $ext from Open VSX..."
      if ! url="$(curl -fsSL --retry 3 --connect-timeout 20 --max-time 60 \
            "https://open-vsx.org/api/${ext%%.*}/${ext#*.}/latest" \
            | jq -er '.files.download')"; then
        warn "$ext: could not resolve a download URL from Open VSX"
        failed=$((failed + 1))
        continue
      fi
      # The VSIX is named after the extension rather than left with mktemp's
      # random suffix, so codium's "was successfully installed" line names
      # something recognisable.
      if ! curl -fsSL --retry 3 --connect-timeout 20 --max-time 180 \
            -o "$vsixdir/$ext.vsix" "$url"; then
        warn "$ext: VSIX download failed"
        failed=$((failed + 1))
        continue
      fi
      NODE_NO_WARNINGS=1 codium --install-extension "$vsixdir/$ext.vsix" --force \
        || { warn "$ext failed to install"; failed=$((failed + 1)); }
    done
  fi
fi

[[ $failed -gt 0 ]] && warn "$failed extension(s) could not be installed — they will be retried on the next apply"
exit 0
