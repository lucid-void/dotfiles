{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "command-raw", // Logo type: auto, builtin, small, file, etc.
    "source": "pokeget sylveon --hide-name",
    "padding": {
      "top": 5, // Top padding
      "left": 10, // Left padding
      "right": 15 // Right padding
    }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "break", "break", "break",
    { "type": "os", "key": "OS   ", "keyColor": "#ed8796" },
    { "type": "kernel", "key": " ├  ", "keyColor": "#ed8796" },
    { "type": "packages", "format": "{31} (pacman)", "key": " ├ 󰏖 ", "keyColor": "#ed8796" },
    { "type": "shell", "key": " └  ", "keyColor": "#ed8796" },
    "break",
    { "type": "wm", "key": "WM   ", "keyColor": "#a6da95" },
    { "type": "wmtheme", "key": " ├ 󰉼 ", "keyColor": "#a6da95" },
    { "type": "icons", "key": " ├ 󰀻 ", "keyColor": "#a6da95" },
    { "type": "cursor", "key": " ├  ", "keyColor": "#a6da95" },
    { "type": "terminal", "key": " ├  ", "keyColor": "#a6da95" },
    { "type": "terminalfont", "key": " └  ", "keyColor": "#a6da95" },
    "break",
    { "type": "host", "format": "{5} {1} Type {2}", "key": "PC   ", "keyColor": "#eed49f" },
    { "type": "cpu", "format": "{1} ({3}) @ {7}", "key": " ├  ", "keyColor": "#eed49f" },
    { "type": "gpu", "format": "{1} {2} @ {12}", "key": " ├ 󰢮 ", "keyColor": "#eed49f" },
    { "type": "memory", "key": " ├  ", "keyColor": "#eed49f" },
    { "type": "swap", "key": " ├ 󰓡 ", "keyColor": "#eed49f" },
    { "type": "disk", "key": " ├ 󰋊 ", "keyColor": "#eed49f" },
    { "type": "monitor", "key": " └  ", "keyColor": "#eed49f" },
    "break",
    "break"
  ]
}