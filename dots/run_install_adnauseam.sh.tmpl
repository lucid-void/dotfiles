#!/usr/bin/env bash
# Installs and updates AdNauseam as an unpacked extension into
# ~/.local/share/adnauseam.
#
# Both browser desktop entries (brave-origin.desktop, chromium.desktop) pass
#   --load-extension=~/.local/share/adnauseam
# via the shared dots/.chezmoitemplates/browser-extension-flags template, so the
# directory has to exist and stay put — Chromium reads it on every launch, it is
# not copied into the browser profile.
#
# AdNauseam is a Manifest V2 extension, which is why the desktop entries also
# pass --disable-features=ExtensionManifestV2Unsupported.
#
# It is deliberately absent from packages/browser-extensions.txt: it is not on
# the Chrome Web Store, so the CRX mechanism that installs everything in that
# list structurally cannot fetch it.
#
# This is a `run_` script, not `run_once_`: it fires on every `chezmoi apply` so
# the extension can pick up new upstream releases. It gates itself on the
# version instead — comparing the installed manifest against the latest release
# tag and downloading nothing when the installed copy is already current. An
# apply with no new release upstream costs one HEAD request and touches nothing
# on disk.
#
# The body is shared with run_install_chromium_web_store.sh.tmpl; the release
# zip holds a single top-level directory, hence nested=true.
{{ includeTemplate "install-unpacked-extension" (dict
     "name"    "adnauseam"
     "dest"    "adnauseam"
     "release" "https://github.com/dhowe/AdNauseam/releases/latest"
     "asset"   "adnauseam.chromium.zip"
     "nested"  true
     "ctx"     .) }}
