#!/usr/bin/env bash
# Installs and updates the chromium-web-store extension (NeverDecaf) as an
# unpacked extension into ~/.local/share/chromium-web-store.
#
# ungoogled-chromium ships with Chrome Web Store integration stripped, so the
# store's install/update buttons don't do anything by default. This extension
# patches them back to working. Upstream's documented install method is
# interactive (flip chrome://flags/#extension-mime-request-handling, then drag
# the .crx onto the browser); loading it unpacked via --load-extension instead
# needs no interactive step, mirroring how AdNauseam is installed.
#
# Both browser desktop entries pass the resulting directory via
# --load-extension in the shared dots/.chezmoitemplates/browser-extension-flags
# template, so the directory has to exist and stay put — Chromium reads it on
# every launch, it is not copied into the browser profile.
#
# This covers the *interactive* path — clicking Install on a store page
# yourself. The declarative path (packages/browser-extensions.txt, applied
# automatically) is run_install_browser_extensions.sh, which is why the
# Developer-mode script and --extension-mime-request-handling exist alongside
# this one.
#
# This is a `run_` script, not `run_once_`: it fires on every `chezmoi apply` so
# the extension can pick up new upstream releases, gating on the installed
# version so an apply with nothing new upstream costs one HEAD request.
#
# The body is shared with run_install_adnauseam.sh.tmpl; upstream ships a .crx
# with manifest.json at its root, hence nested=false.
{{ includeTemplate "install-unpacked-extension" (dict
     "name"    "chromium-web-store"
     "dest"    "chromium-web-store"
     "release" "https://github.com/NeverDecaf/chromium-web-store/releases/latest"
     "asset"   "Chromium.Web.Store.crx"
     "nested"  false
     "ctx"     .) }}
